<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lijolo</groupId>
  <artifactId>lijolo-service</artifactId>
  <version>HEAD-SNAPSHOT</version>
  <packaging>jar</packaging>

  <description>lijolo Parent</description>

  <inceptionYear>2025</inceptionYear>

  <scm>
    <connection>scm:git@github.com:FrankHossfeld/lijolo-model.git</connection>
    <developerConnection>scm:git:git@github.com:FrankHossfeld/lijolo-model.git</developerConnection>
    <url>scm:git:https://github.com/FrankHossfeld/lijolo-model</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/FrankHossfeld/lijolo-model/issues</url>
  </issueManagement>

  <properties>
    <aws.version>2.38.7</aws.version>
    <jakarta.xml.binding.version>4.0.2</jakarta.xml.binding.version>
    <jooq.version>3.20.8</jooq.version>
    <lijolo.model.version>HEAD-SNAPSHOT</lijolo.model.version>
    <liquibase.version>5.0.1</liquibase.version>
    <postgresql.driver.version>42.7.8</postgresql.driver.version>
    <slf4j.version>2.0.16</slf4j.version>

    <junit.platform.version>1.13.1</junit.platform.version>
    <junit.version>5.13.1</junit.version>
    <testcontainers.version>1.21.1</testcontainers.version>

    <plugin.version.compiler>3.12.1</plugin.version.compiler>
    <plugin.version.javadoc>3.11.2</plugin.version.javadoc>
    <plugin.version.source>3.3.0</plugin.version.source>
    <plugin.version.surefire>3.5.2</plugin.version.surefire>
    <plugin.version.resource>3.3.1</plugin.version.resource>

    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.lijolo</groupId>
      <artifactId>lijolo-model</artifactId>
      <version>${lijolo.model.version}</version>
    </dependency>

    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>${jakarta.xml.binding.version}</version>
    </dependency>

    <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

